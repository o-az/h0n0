{
  "name": "h0n0",
  "version": "0.0.0",
  "license": "MIT",
  "repository": "github:o-az/h0n0",
  "type": "module",
  "imports": {
    "#*": "./src/*",
    "#package.json": "./package.json",
    "#wrangler.json": "./wrangler.json"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build --mode='production' --config='vite.config.ts'",
    "preview": "vite preview",
    "test": "vitest --run",
    "format": "oxfmt --config='oxfmt.config.ts' --write",
    "lint": "oxlint --config='oxlint.config.ts' --type-aware --type-check --fix-dangerously",
    "check": "bun format && bun lint",
    "check:types": "bun tsc --project tsconfig.json --noEmit",
    "deploy": "NODE_ENV='production' wrangler deploy",
    "types": "wrangler types --env-file='.env.example'"
  },
  "dependencies": {
    "@std/ulid": "npm:@jsr/std__ulid",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@vitejs/devtools": "^0.8.0",
    "@vitest/ui": "^5.0.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "packageManager": "bun@1.4.4"
}
